---
import SiteLayout from '../../layouts/SiteLayout.astro';
import { subpages } from '../../content/subpages.js';
export function getStaticPaths() { return [
  { params: { lang: 'de', slug: 'hotel' }, props: { pageKey: 'hotel' } },
  { params: { lang: 'de', slug: 'zimmer' }, props: { pageKey: 'rooms' } },
  { params: { lang: 'de', slug: 'events' }, props: { pageKey: 'events' } },
  { params: { lang: 'de', slug: 'greiz' }, props: { pageKey: 'greiz' } },
  { params: { lang: 'de', slug: 'umgebung' }, props: { pageKey: 'greiz' } },
  { params: { lang: 'de', slug: 'tagungevent' }, props: { pageKey: 'events' } },
  { params: { lang: 'de', slug: 'kontakt' }, props: { pageKey: 'contact' } },
  { params: { lang: 'de', slug: 'anfahrt' }, props: { pageKey: 'arrival' } },
  { params: { lang: 'de', slug: 'gaestemappe' }, props: { pageKey: 'guide' } },
  { params: { lang: 'en', slug: 'hotel' }, props: { pageKey: 'hotel' } },
  { params: { lang: 'en', slug: 'rooms' }, props: { pageKey: 'rooms' } },
  { params: { lang: 'en', slug: 'events' }, props: { pageKey: 'events' } },
  { params: { lang: 'en', slug: 'greiz' }, props: { pageKey: 'greiz' } },
  { params: { lang: 'en', slug: 'contact' }, props: { pageKey: 'contact' } },
  { params: { lang: 'en', slug: 'arrival' }, props: { pageKey: 'arrival' } },
  { params: { lang: 'en', slug: 'guest-guide' }, props: { pageKey: 'guide' } },
]; }
const lang = Astro.params.lang === 'en' ? 'en' : 'de';
const de = lang === 'de';
const pageKey = Astro.props.pageKey;
const canonicalPath = pageKey === 'greiz' && Astro.params.slug === 'umgebung' ? '/de/greiz/' : pageKey === 'events' && Astro.params.slug === 'tagungevent' ? '/de/events/' : undefined;
const bookingUrl = 'https://buchung.schlossberghotel-greiz.de/onlinebuchung/views/onlinebuchung.php?cds_id=1';
const eventMail = 'mailto:info@schlossberghotel-greiz.de?subject=Anfrage%20Saal%20am%20Schlossberg';
const copy = {
  hotel: de ? { title: 'Ein Haus mitten in Greiz.', kicker: 'DAS SCHLOSSBERGHOTEL', lead: 'Am Fuße des Oberen Schlosses und mitten im Leben der Residenzstadt: ein ruhiger Ort zum Ankommen, Ausruhen und Aufbrechen.', body: 'Das Schlossberghotel verbindet eine zentrale Lage mit einer persönlichen, entspannten Atmosphäre. Starten Sie mit dem Frühstücksbuffet in den Tag, nehmen Sie Platz in der Lounge oder lassen Sie den Abend auf der Dachterrasse ausklingen.', sections: [['Ein guter Ausgangspunkt', 'Historische Gassen, Schlosspark und die Wege ins Vogtland beginnen nur wenige Schritte vom Hotel entfernt.'], ['Zeit für eine Pause', 'Zur Ausstattung gehören Frühstücksbuffet, Lounge, Dachterrasse und Aufzug. Check-in ist ab 15:00 Uhr möglich, Check-out bis 11:00 Uhr.'], ['Platz für Ihre Reise', 'Im Haus erwarten Sie 31 Zimmer, darunter fünf Suiten, zwei Familienzimmer und ein barrierefreies Zimmer.']] } : { title: 'A hotel in the heart of Greiz.', kicker: 'SCHLOSSBERGHOTEL', lead: 'At the foot of the Upper Castle and close to everything in town: a calm place to arrive, unwind and set out.', body: 'Schlossberghotel pairs a central location with a relaxed, personal feel. Start the day with the breakfast buffet, settle into the lounge or wind down on the rooftop terrace.', sections: [['A place to begin', 'Historic lanes, the castle park and routes into the Vogtland are just a short walk from the hotel.'], ['Time to pause', 'Facilities include a breakfast buffet, lounge, rooftop terrace and lift. Check-in is from 3:00 pm; check-out is by 11:00 am.'], ['Room for your stay', 'The hotel has 31 rooms, including five suites, two family rooms and one accessible room.']] },
  rooms: de ? { title: 'Ein Zimmer für Ihren eigenen Rhythmus.', kicker: 'ZIMMER & SUITEN', lead: 'Klare Formen, viel Raum zum Durchatmen und ein guter Ausgangspunkt für Ihre Zeit in Greiz.', body: 'Wählen Sie aus Design- und Klassikzimmern, großzügigen Suiten und einem barrierefreien Zimmer. Die Verfügbarkeit und aktuellen Preise finden Sie direkt in unserem Buchungssystem.', sections: [['Designzimmer', '24–26 m² · TV, WLAN, Schreibtisch, Dusche, Föhn und Kosmetikspiegel. Ein Babybett ist auf Anfrage möglich.'], ['Klassikzimmer', '22–24 m² · im Dachgeschoss, mit Twin- oder Doppelbett, TV, WLAN, Schreibtisch und Dusche.'], ['Design Suite', 'Zwei abschließbare Räume, Schlafsofa, zwei TVs, Nespresso-Maschine, Wasserkocher und WLAN. Größer als das Designzimmer.'], ['Klassik Suite', '44–64 m² · Schlaf- und Wohnbereich mit bis zu vier Schlafplätzen, zwei abschließbare Räume und Schlafsofa.'], ['Barrierefreies Zimmer', '45 m² · stufenlose, große Dusche und unterfahrbares Waschbecken. Ein Parkplatz kann auf Anfrage reserviert werden.'], ['Exklusiv Suite', 'Kingsize-Bett, offenes Bad im Wohn- und Schlafbereich, Nespresso-Maschine, Minibar/Kühlschrank und elektrischer Kamin.']] } : { title: 'A room for your own rhythm.', kicker: 'ROOMS & SUITES', lead: 'Thoughtful details, space to unwind and a welcoming base for your time in Greiz.', body: 'Choose from Design and Classic rooms, spacious suites and an accessible room. Check current availability and rates through our booking system.', sections: [['Design Room', '24–26 m² · TV, Wi-Fi, desk, shower, hair dryer and cosmetic mirror. A baby cot is available on request.'], ['Classic Room', '22–24 m² · on the top floor, with twin or double beds, TV, Wi-Fi, desk and shower.'], ['Design Suite', 'Two lockable rooms, sofa bed, two TVs, Nespresso machine, kettle and Wi-Fi. Larger than the Design Room.'], ['Classic Suite', '44–64 m² · sleeping and living areas for up to four, with two lockable rooms and a sofa bed.'], ['Accessible Room', '45 m² · large step-free shower and accessible washbasin. A parking space can be reserved on request.'], ['Exclusive Suite', 'King-size bed, open-plan bath in the living/sleeping area, Nespresso machine, minibar/fridge and electric fireplace.']] },
  events: de ? { title: 'Raum für Begegnungen.', kicker: 'FEIERN & TAGEN', lead: 'Ein besonderer Rahmen für private Feiern, Tagungen und gemeinsame Ideen – mitten in Greiz.', body: 'Der Saal am Schlossberg bietet auf 225 m² Platz für unterschiedliche Anlässe. Die angrenzende Terrasse ist 65 m² groß. Für Speisen und Getränke können regionale Caterer eingebunden werden.', sections: [['Ausstattung', 'Rednerpult, Ultra-HD-Beamer, Klimaanlage, WLAN, moderne Küche und Tontechnik.'], ['Ein Raum für vieles', 'Hochzeiten, Jubiläen, Geburtstage und Empfänge sind ebenso möglich wie Meetings, Workshops, Seminare, Vorträge und Präsentationen.'], ['Gemeinsam planen', 'Erzählen Sie uns von Ihrem Anlass. Wir besprechen mit Ihnen die Details und passende Möglichkeiten.']] } : { title: 'A place to come together.', kicker: 'CELEBRATIONS & MEETINGS', lead: 'A distinctive setting for private celebrations, meetings and shared ideas in the heart of Greiz.', body: 'Saal am Schlossberg offers 225 m² for a range of occasions, with an adjoining 65 m² terrace. Regional caterers can support food and drink planning.', sections: [['Equipment', 'Lectern, Ultra HD projector, air conditioning, Wi-Fi, modern kitchen and sound equipment.'], ['A room for many occasions', 'Weddings, anniversaries, birthdays and receptions, as well as meetings, workshops, seminars, talks and presentations.'], ['Plan together', 'Tell us about your occasion. We can discuss the details and options with you.']] },
  greiz: de ? { title: 'Die Stadt vor der Tür. Die Natur gleich weiter.', kicker: 'GREIZ ENTDECKEN', lead: 'Eine kleine Stadt mit großer Geschichte – und viel Landschaft gleich hinter den Dächern.', body: 'Vom Hotel aus entdecken Sie Greiz Schritt für Schritt: das Obere Schloss, historische Häuser, Museen und den Schlosspark. Die Weiße Elster und die bewaldeten Höhen des Vogtlands laden zu Spaziergängen und Radtouren ein.', sections: [['Geschichte & Architektur', 'Das Obere Schloss, die Altstadt und Häuser im Jugendstil erzählen von Greiz als ehemaliger Residenzstadt.'], ['Draußen unterwegs', 'Der Schlosspark, das Tal der Weißen Elster und die umliegenden Hügel bieten Raum zum Spazierengehen und Radfahren.'], ['Ein Ausflug ins Vogtland', 'Auch die Göltzschtalbrücke ist ein lohnendes Ziel in der Region.']] } : { title: 'The town outside. The countryside just beyond.', kicker: 'EXPLORE GREIZ', lead: 'A small town with a rich past, with open countryside just beyond the rooftops.', body: 'Explore Greiz from the hotel: the Upper Castle, historic buildings, museums and the castle park. The White Elster valley and wooded Vogtland hills invite you to walk or cycle.', sections: [['History & architecture', 'The Upper Castle, old town and Art Nouveau buildings tell the story of Greiz as a former residence town.'], ['Out in the open', 'The castle park, the White Elster valley and surrounding hills make space for walks and cycling.'], ['A Vogtland day out', 'The Göltzschtalbrücke is another memorable destination in the region.']] },
  contact: de ? { title: 'Gut zu erreichen. Gut anzukommen.', kicker: 'ANREISE & KONTAKT', lead: 'Wir freuen uns auf Ihren Besuch. Hier finden Sie die wichtigsten Angaben für Ihre Anreise und Ihre Fragen.', body: 'Das Schlossberghotel liegt in der Marienstraße im Zentrum von Greiz. Die Tiefgarage befindet sich unter dem Hotel; die Einfahrt erfolgt laut Anreiseinformation über den Neuen Weg. Von der Garage gelangen Sie mit dem Aufzug zum Hotel.', sections: [['Adresse', 'Schlossberghotel Greiz\nMarienstr. 1–5\n07973 Greiz, Deutschland'], ['Kontakt', '+49 (0) 36 61/6 22-123\ninfo@schlossberghotel-greiz.de'], ['Zeiten', 'Check-in ab 15:00 Uhr\nCheck-out bis 11:00 Uhr']] } : { title: 'Easy to reach, easy to arrive.', kicker: 'ARRIVAL & CONTACT', lead: 'We look forward to welcoming you. Here are the essentials for finding us and getting in touch.', body: 'Schlossberghotel is on Marienstrasse in central Greiz. The underground garage is below the hotel; according to the general arrival information, enter via Neuer Weg. A lift connects the garage with the hotel.', sections: [['Address', 'Schlossberghotel Greiz\nMarienstr. 1–5\n07973 Greiz, Germany'], ['Contact', '+49 (0) 36 61/6 22-123\ninfo@schlossberghotel-greiz.de'], ['Times', 'Check-in from 3:00 pm\nCheck-out by 11:00 am']] }
};
copy.arrival = de
  ? { ...copy.contact, title: 'Gut ankommen in Greiz.', kicker: 'ANFAHRT', lead: 'Die Tiefgarage liegt direkt unter dem Hotel. Hier finden Sie die Anschrift und die letzte Wegbeschreibung für Ihre Anreise.', body: 'Bitte fahren Sie zur Tiefgarage über die Straße Neuer Weg. Nach dem Parken gelangen Sie mit dem Aufzug direkt zum Hotel. Für Veranstaltungsbesucher gelten abweichende Angaben; bitte stimmen Sie die Zufahrt zum Saal direkt mit dem Hotel ab.' }
  : { ...copy.contact, title: 'Arrive easily in Greiz.', kicker: 'ARRIVAL', lead: 'The underground garage is directly below the hotel. Find the address and the final directions for your arrival here.', body: 'Enter the underground garage via Neuer Weg. After parking, take the lift directly to the hotel. Event visitors may have different access arrangements; please confirm the route with the hotel.' };
copy.guide = de
  ? { title: 'Ihre Gästemappe für Greiz.', kicker: 'GÄSTEMAPPE', lead: 'Nützliche Informationen, lokale Empfehlungen und ein paar Antworten für Ihren Aufenthalt.', body: 'Von Frühstückszeiten und Parken bis zu Ausflügen und Restaurants in der Nähe: Hier finden Sie die Details, die den Aufenthalt leichter machen.', sections: [['Gut zu wissen von A bis Z', 'An- und Abreise, Frühstück, Tiefgarage, WLAN und weitere praktische Hinweise.'], ['Kulinarisches in Greiz', 'Restaurants und Cafés in der Nähe, mit Adresse und Telefonnummer.']] }
  : { title: 'Your guest guide to Greiz.', kicker: 'GUEST GUIDE', lead: 'Useful hotel details, local recommendations and a few answers for your stay.', body: 'From breakfast and parking to nearby restaurants and activities, find the details that help your stay run smoothly.', sections: [['Useful to know, A to Z', 'Arrival, breakfast, garage, Wi-Fi and other practical details.'], ['Food & drink in Greiz', 'Nearby restaurants and cafés, with addresses and phone numbers.']] };
const data = copy[pageKey];
const primary = pageKey === 'events' ? eventMail : pageKey === 'guide' ? (de ? '/de/gaestemappe/auf-einen-blick-von-a-z/' : '/en/guest-guide/guest-information/') : pageKey === 'contact' || pageKey === 'arrival' ? 'https://maps.google.com/?q=Schlossberghotel+Greiz,+Marienstr.+1-5,+07973+Greiz' : bookingUrl;
const buttonLabel = pageKey === 'events' ? (de ? 'Anfrage per E-Mail' : 'Enquire by email') : pageKey === 'contact' || pageKey === 'arrival' ? (de ? 'Route öffnen' : 'Open directions') : pageKey === 'guide' ? (de ? 'Gästeinformation öffnen' : 'Open guest information') : pageKey === 'rooms' ? (de ? 'Verfügbarkeit prüfen' : 'Check availability') : (de ? 'Zimmer buchen' : 'Book a room');
const introHeading = pageKey === 'hotel' ? (de ? 'Das Haus' : 'The hotel') : pageKey === 'rooms' ? (de ? 'Zimmer & Suiten' : 'Rooms & suites') : pageKey === 'events' ? (de ? 'Für Ihren Anlass' : 'For your event') : pageKey === 'greiz' ? (de ? 'Vor der Tür' : 'Just outside') : (de ? 'Gut zu wissen' : 'Before you arrive');
const heroPhoto = pageKey === 'hotel' || pageKey === 'contact' || pageKey === 'arrival' ? '/images/schlossberghotel-entrance-visualization.webp' : pageKey === 'rooms' ? '/images/schlossberghotel-designzimmer.jpg' : pageKey === 'events' ? '/images/saal-am-schlossberg-lounge.jpg' : pageKey === 'guide' ? '/images/schlossberghotel-breakfast.jpg' : '/images/greiz-town-panorama.jpg';
const photoCaption = pageKey === 'guide'
  ? (de ? 'Frühstücksraum · Originalaufnahme des Hotels' : 'Breakfast room · original hotel photograph')
  : pageKey === 'hotel'
  ? (de ? 'Außenansicht · KI-Visualisierung nach dem Originalfoto, kein dokumentarisches Foto' : 'Hotel entrance · AI visualization based on the original photo, not documentary photography')
  : pageKey === 'rooms'
    ? (de ? 'Designzimmer · Originalaufnahme des Hotels' : 'Design Room · photograph from the hotel')
    : pageKey === 'events'
      ? (de ? 'Lounge im Saal am Schlossberg' : 'Lounge in Saal am Schlossberg')
      : pageKey === 'greiz'
        ? (de ? 'Greiz · illustriertes Panorama, nicht maßstabsgetreu' : 'Greiz · illustrated panorama, not to scale')
        : (de ? 'Hoteleingang · KI-Visualisierung nach dem Originalfoto' : 'Hotel entrance · AI visualization based on the original photo');
const roomPhotos = ['/images/schlossberghotel-designzimmer.jpg', '/images/schlossberghotel-klassikzimmer.jpg', '/images/schlossberghotel-design-suite.jpg', '/images/schlossberghotel-klassik-suite.jpg', null, '/images/schlossberghotel-exklusiv-suite.jpg'];
const roomSlugs = de ? ['designzimmer', 'klassikzimmer', 'design-suite', 'klassik-suite', 'barrierefreies-zimmer', 'exklusiv-suite'] : ['design-room', 'classic-room', 'design-suite', 'classic-suite', 'accessible-room', 'exclusive-suite'];
---
<SiteLayout lang={lang} current={pageKey} canonicalPath={canonicalPath} title={data.title} description={`${data.title} ${data.lead}`} heroImage={heroPhoto}>
  <section class:list={['page-hero', `page-hero--${pageKey}`]}><div class="page-hero-copy"><div class="breadcrumb"><a href={de ? '/de/' : '/en/'}>{de ? 'Start' : 'Home'}</a><span>/</span><span>{data.kicker}</span></div><h1 class="hero-heading">{data.title.split(' ').map((word, index, words) => <span class="hero-word">{word}{index < words.length - 1 ? ' ' : ''}</span>)}</h1><p class="page-lede">{data.lead}</p><a class="button button-light" href={primary} target={pageKey === 'events' ? undefined : '_blank'} rel="noreferrer">{buttonLabel}<span aria-hidden="true">↗</span></a><div class="page-hero-meta"><span>SCHLOSSBERGHOTEL GREIZ</span><span>MARIENSTR. 1–5 · 07973 GREIZ</span></div></div><div class:list={['page-hero-art', `page-hero-art--${pageKey}`]}><img data-image-reveal src={heroPhoto} alt={pageKey === 'hotel' || pageKey === 'contact' || pageKey === 'arrival' ? (de ? 'KI-Visualisierung des Hoteleingangs auf Basis des Originalfotos' : 'AI visualization of the hotel entrance based on the original photograph') : pageKey === 'rooms' ? (de ? 'Designzimmer im Schlossberghotel' : 'A Design Room at Schlossberghotel') : pageKey === 'events' ? (de ? 'Lounge des Saals am Schlossberg' : 'The lounge in Saal am Schlossberg') : pageKey === 'greiz' ? (de ? 'Künstlerisches Panorama von Greiz mit der Weißen Elster und dem Oberen Schloss, nicht maßstabsgetreu' : 'Illustrated panorama of Greiz with the White Elster and Upper Castle, not to scale') : pageKey === 'guide' ? (de ? 'Frühstücksraum im Schlossberghotel' : 'Breakfast room at Schlossberghotel') : (de ? 'Eingang des Schlossberghotels in der Marienstraße' : 'Entrance to Schlossberghotel on Marienstrasse')} />{pageKey === 'events' && <div class="hero-art-stat"><strong>225</strong><span>m²<br />{de ? 'SAAL AM SCHLOSSBERG' : 'SAAL AM SCHLOSSBERG'}</span><i>65 m² · {de ? 'TERRASSE' : 'TERRACE'}</i></div>}{(pageKey === 'contact' || pageKey === 'arrival') && <address class="arrival-plate"><span>{de ? 'MITTEN IN GREIZ' : 'IN CENTRAL GREIZ'}</span><strong>Marienstr.<br />1–5</strong><small>07973 Greiz<br />Deutschland / Germany</small></address>}<span>{photoCaption}</span></div></section>
  <section class="page-intro section-pad"><div><h2>{introHeading}</h2></div><p class="intro-body">{data.body}</p></section>
  {pageKey === 'rooms' ? <section class="room-list" aria-label={de ? 'Zimmer und Suiten' : 'Rooms and suites'}>{data.sections.map(([title, text], i) => <article class:list={['room-row', roomPhotos[i] ? 'room-row--image' : 'room-row--text']}>{roomPhotos[i] && <figure class="room-row-photo"><img src={roomPhotos[i]} alt={de ? `Originalaufnahme: ${title} im Schlossberghotel` : `Hotel photograph: ${title} at Schlossberghotel`} loading="lazy" /><figcaption>{de ? 'Originalfoto des Hotels' : 'Hotel photograph'}</figcaption></figure>}<div class="room-row-content"><span class="room-num">{de ? `ZIMMER ${String(i + 1).padStart(2, '0')}` : `ROOM ${String(i + 1).padStart(2, '0')}`}</span><h2>{title}</h2><a href={`${de ? '/de/zimmer/' : '/en/rooms/'}${roomSlugs[i]}/`} aria-label={`${de ? 'Details ansehen' : 'View details'}: ${title}`}>Details <span aria-hidden="true">↗</span></a><p>{text}</p></div></article>)}</section> : pageKey === 'events' ? <section class="event-facts section-pad"><div class="event-fact-large"><span>225</span><small>m² · SAAL AM SCHLOSSBERG</small></div><div class="event-fact-grid">{data.sections.map(([title, text]) => <article><h2>{title}</h2><p>{text}</p></article>)}</div><div class="event-terrace"><span>65 m²</span><small>{de ? 'TERRASSE' : 'TERRACE'}</small></div></section> : (pageKey === 'contact' || pageKey === 'arrival') ? <section class="contact-grid section-pad">{data.sections.map(([title, text], i) => <article><h2>{title}</h2><p>{text}</p>{i === 0 && <a class="text-link" href="https://maps.google.com/?q=Schlossberghotel+Greiz,+Marienstr.+1-5,+07973+Greiz" target="_blank" rel="noreferrer">{de ? 'Karte öffnen' : 'Open map'} <span aria-hidden="true">↗</span></a>}{i === 1 && <><a class="text-link" href="tel:+493661622123">{de ? 'Anrufen' : 'Call'} <span aria-hidden="true">↗</span></a><a class="text-link" href="mailto:info@schlossberghotel-greiz.de">{de ? 'E-Mail schreiben' : 'Email us'} <span aria-hidden="true">↗</span></a></>}</article>)}</section> : pageKey === 'guide' ? <section class="subpage-related section-pad" aria-label={de ? 'In der Gästemappe' : 'Guest information'}><div>{data.sections.map((item, i) => <a href={i === 0 ? (de ? '/de/gaestemappe/auf-einen-blick-von-a-z/' : '/en/guest-guide/guest-information/') : (de ? '/de/gaestemappe/kulinarisches/' : '/en/guest-guide/nearby-dining/')}>{item[0]}<span aria-hidden="true">↗</span></a>)}</div></section> : <section class="detail-grid section-pad">{data.sections.map(([title, text], i) => <article><span class="fact-index">{String(i + 1).padStart(2, '0')} · {data.kicker}</span><h2>{title}</h2><p>{text}</p></article>)}</section>}
  {pageKey === 'rooms' && <section class="detail-grid section-pad"><article><span class="fact-index">{de ? 'ALLGEMEIN' : 'GENERAL'}</span><h2>{de ? 'Im ganzen Haus' : 'Across the hotel'}</h2><p>{de ? 'Aufzug, Terrasse, Schuhputzautomat und ein Getränkeautomat in der Lobby. Ein Außenbereich für Raucher ist vorhanden.' : 'Lift, terrace, shoe-shine machine and a drinks machine in the lobby. An outdoor smoking area is available.'}</p></article><article><span class="fact-index">{de ? 'ZEITEN & TARIFE' : 'TIMES & RATES'}</span><h2>{de ? 'Anreise planen' : 'Plan your stay'}</h2><p>{de ? 'Anreise ab 15:00 Uhr, Abreise bis 11:00 Uhr. Buchungs- und Stornierungsbedingungen unterscheiden sich je nach gewählter Rate.' : 'Check-in from 3:00 pm; check-out by 11:00 am. Booking and cancellation terms vary by rate.'}</p></article><article><span class="fact-index">{de ? 'DIREKTBUCHUNG' : 'BOOK DIRECT'}</span><h2>{de ? 'Bestpreisgarantie' : 'Best-rate guarantee'}</h2><p>{de ? 'Das bisherige Angebot sieht einen Preisabgleich bei gleichen Bedingungen vor. Senden Sie dem Hotel den Vergleich, Reisedatum und Anfragezeitpunkt. Nicht für bestehende Buchungen.' : 'The previous offer matches a lower price found elsewhere for the same terms. Send the hotel a screenshot, travel date and time of enquiry. Existing bookings are excluded.'}</p></article><article><span class="fact-index">{de ? 'ZAHLUNG' : 'PAYMENT'}</span><h2>{de ? 'Akzeptierte Karten' : 'Accepted payments'}</h2><p>{de ? 'Barzahlung in Landeswährung, EC-Karte, Maestro, Mastercard, American Express, Diners Club und Visa.' : 'Cash in local currency, EC card, Maestro, Mastercard, American Express, Diners Club and Visa.'}</p></article></section>}
