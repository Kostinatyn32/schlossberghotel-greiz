  {pageKey === 'hotel' && <><section class="stats-band"><div><strong>31</strong><span>{de ? 'Zimmer' : 'rooms'}</span></div><div><strong>5</strong><span>{de ? 'Suiten' : 'suites'}</span></div><div><strong>2</strong><span>{de ? 'Familienzimmer' : 'family rooms'}</span></div><div><strong>1</strong><span>{de ? 'barrierefreies Zimmer' : 'accessible room'}</span></div></section><section class="photo-grid" aria-label={de ? 'Impressionen aus dem Hotel' : 'Hotel photographs'}><figure><img src="/images/schlossberghotel-breakfast.jpg" alt={de ? 'Tische im Frühstücksraum des Schlossberghotels' : 'Tables in the Schlossberghotel breakfast room'} loading="lazy" /><figcaption>{de ? 'Frühstücksraum · Originalaufnahme des Hotels' : 'Breakfast room · photograph from the hotel'}</figcaption></figure><figure><img src="/images/schlossberghotel-terrace.jpg" alt={de ? 'Möblierte Dachterrasse des Schlossberghotels' : 'Furnished rooftop terrace at Schlossberghotel'} loading="lazy" /><figcaption>{de ? 'Dachterrasse · Originalaufnahme des Hotels' : 'Rooftop terrace · photograph from the hotel'}</figcaption></figure></section></>}
